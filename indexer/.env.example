DATABASE_URL="postgresql://user:password@localhost:5432/bc_forge?schema=public"
RPC_URL="https://soroban-testnet.stellar.org"
CONTRACT_ID="CABC...XYZ"
PORT=3000

# Bearer token protecting /api/v1/* endpoints.
# Generate with: openssl rand -base64 32
# Required at runtime — never commit a real value here.
INDEXER_API_TOKEN="replace-with-a-long-random-secret"

# Per-IP rate limiting for the /api/v1 routes (GET /health is never limited).
# Defaults: 60 requests per 60000 ms window.
INDEXER_RATE_LIMIT_WINDOW_MS=60000
INDEXER_RATE_LIMIT_MAX=60
